NODE_ENV=development
DEPLOY_ENV=local
TZ=Asia/Shanghai
PORT=3310
HOST=0.0.0.0
SERVICE_NAME=github-trend-intelligence
LOG_LEVEL=info

# 可选。未配置也能抓取，配置后 GitHub REST 限额明显提高。
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
GITHUB_WEB_BASE=https://github.com
OSSINSIGHT_API_BASE=https://api.ossinsight.io

# 采集策略
MAX_CANDIDATES=60
ENRICH_CONCURRENCY=4
SEARCH_LOOKBACK_DAYS=14
TRENDING_WINDOWS=daily,weekly
OSSINSIGHT_ENABLED=true
AUTO_COLLECT=false
COLLECT_DAILY_AT=09:00

# 本地 docker compose 默认连接；生产值只放服务器 .env。
DATABASE_URL=postgresql://github_trend:github_trend_local_only@127.0.0.1:35432/github_trend?schema=public

# 内部 HTTP API 鉴权。生产必须替换为高强度随机值，只放服务器 .env。
API_TOKEN=<GENERATE_A_STRONG_RANDOM_TOKEN>
LOKI_URL=
LOKI_TOKEN=

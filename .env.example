NODE_ENV=development
DEPLOY_ENV=local
TZ=Asia/Shanghai
PORT=3310
HOST=0.0.0.0
SERVICE_NAME=github-trend-intelligence
LOG_LEVEL=info

# 可选。未配置也能抓取，配置后 GitHub REST 限额明显提高。
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
GITHUB_WEB_BASE=https://github.com
OSSINSIGHT_API_BASE=https://api.ossinsight.io

# 采集策略
MAX_CANDIDATES=60
ENRICH_CONCURRENCY=4
SEARCH_LOOKBACK_DAYS=14
TRENDING_WINDOWS=daily,weekly
OSSINSIGHT_ENABLED=true
AUTO_COLLECT=false
COLLECT_INTERVAL_MINUTES=60

# 本地 docker compose 默认连接；生产替换成云 MySQL。
DATABASE_URL=mysql://github_trend:github_trend@127.0.0.1:33306/github_trend

# 可选：人工触发采集接口鉴权；为空时仅建议本机使用。
INTERNAL_TOKEN=
LOKI_URL=
LOKI_TOKEN=

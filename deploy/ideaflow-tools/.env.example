NODE_ENV=production
DEPLOY_ENV=ideaflow-tools
TZ=Asia/Shanghai
PORT=3310
HOST=0.0.0.0
SERVICE_NAME=github-trend-intelligence
LOG_LEVEL=info

# 以下三项只写入服务器 .env，不进入镜像或 Git。
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<POSTGRES_HOST>:5432/<DATABASE>?schema=public
API_TOKEN=<GENERATE_A_STRONG_RANDOM_TOKEN>
GITHUB_TOKEN=

GITHUB_API_BASE=https://api.github.com
GITHUB_WEB_BASE=https://github.com
OSSINSIGHT_API_BASE=https://api.ossinsight.io
MAX_CANDIDATES=60
ENRICH_CONCURRENCY=4
SEARCH_LOOKBACK_DAYS=14
TRENDING_WINDOWS=daily,weekly
OSSINSIGHT_ENABLED=true
AUTO_COLLECT=false
# 仅在 AUTO_COLLECT=true 时生效；生产日报由本地 Codex 于 08:00 调用采集接口。
COLLECT_DAILY_AT=08:00
LOKI_URL=
LOKI_TOKEN=

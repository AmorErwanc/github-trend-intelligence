generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Repository {
  id              String   @id(map: "gtr_repo_pk") @db.Char(24)
  githubRepoId    BigInt   @unique(map: "gtr_repo_github_uq") @map("github_repo_id") @db.BigInt
  fullName        String   @unique(map: "gtr_repo_full_name_uq") @map("full_name") @db.VarChar(255)
  owner           String   @db.VarChar(128)
  name            String   @db.VarChar(128)
  htmlUrl         String   @map("html_url") @db.VarChar(512)
  description     String?  @db.Text
  primaryLanguage String?  @map("primary_language") @db.VarChar(64)
  archetype       String   @default("unknown") @db.VarChar(32)
  createdAtGithub DateTime @map("created_at_github") @db.Timestamptz(3)
  pushedAtGithub  DateTime @map("pushed_at_github") @db.Timestamptz(3)
  archived        Boolean  @default(false)
  firstSeenAt     DateTime @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt      DateTime @map("last_seen_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([lastSeenAt], map: "gtr_repo_last_seen_idx")
  @@index([primaryLanguage, lastSeenAt], map: "gtr_repo_lang_seen_idx")
  @@map("github_trend_repository")
}

model RepositorySnapshot {
  id             String   @id(map: "gtr_snap_pk") @db.Char(24)
  repositoryId   String   @map("repository_id") @db.Char(24)
  capturedAt     DateTime @map("captured_at") @db.Timestamptz(3)
  stars          Int
  forks          Int
  watchers       Int
  subscribers    Int
  openIssues     Int      @map("open_issues")
  networkCount   Int      @map("network_count")
  sizeKb         Int      @map("size_kb")
  defaultBranch  String   @map("default_branch") @db.VarChar(128)
  licenseSpdx    String?  @map("license_spdx") @db.VarChar(64)
  topics         Json
  hasIssues      Boolean  @map("has_issues")
  hasDiscussions Boolean  @map("has_discussions")
  isFork         Boolean  @map("is_fork")
  sourcePayload  Json?    @map("source_payload")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([repositoryId, capturedAt], map: "gtr_snap_repo_time_uq")
  @@index([repositoryId, capturedAt], map: "gtr_snap_repo_time_idx")
  @@index([capturedAt], map: "gtr_snap_time_idx")
  @@map("github_trend_repository_snapshot")
}

model RankingSnapshot {
  id            String   @id(map: "gtr_rank_pk") @db.Char(24)
  repositoryId  String   @map("repository_id") @db.Char(24)
  capturedAt    DateTime @map("captured_at") @db.Timestamptz(3)
  source        String   @db.VarChar(32)
  window        String   @db.VarChar(32)
  rank          Int
  periodStars   Int?     @map("period_stars")
  sourceScore   Float?   @map("source_score")
  sourcePayload Json?    @map("source_payload")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([repositoryId, capturedAt, source, window], map: "gtr_rank_repo_time_src_win_uq")
  @@index([source, window, capturedAt, rank], map: "gtr_rank_src_win_time_idx")
  @@index([repositoryId, capturedAt], map: "gtr_rank_repo_time_idx")
  @@map("github_trend_ranking_snapshot")
}

model RepositoryArtifact {
  id           String   @id(map: "gtr_artifact_pk") @db.Char(24)
  repositoryId String   @map("repository_id") @db.Char(24)
  kind         String   @db.VarChar(32)
  ref          String?  @db.VarChar(128)
  content      String   @db.Text
  contentHash  String   @map("content_hash") @db.Char(64)
  fetchedAt    DateTime @map("fetched_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([repositoryId, kind, contentHash], map: "gtr_artifact_repo_kind_hash_uq")
  @@index([repositoryId, kind, fetchedAt], map: "gtr_artifact_repo_kind_time_idx")
  @@map("github_trend_repository_artifact")
}

model RepositoryScore {
  id                 String   @id(map: "gtr_score_pk") @db.Char(24)
  repositoryId       String   @map("repository_id") @db.Char(24)
  scoredAt           DateTime @map("scored_at") @db.Timestamptz(3)
  trendHeat          Float    @map("trend_heat")
  technicalSubstance Float    @map("technical_substance")
  manipulationRisk   Float    @map("manipulation_risk")
  confidence         String   @db.VarChar(16)
  classification     String   @db.VarChar(48)
  features           Json
  evidence           Json
  algorithmVersion   String   @map("algorithm_version") @db.VarChar(32)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([repositoryId, scoredAt, algorithmVersion], map: "gtr_score_repo_time_algo_uq")
  @@index([scoredAt, trendHeat], map: "gtr_score_time_heat_idx")
  @@index([scoredAt, manipulationRisk], map: "gtr_score_time_risk_idx")
  @@index([repositoryId, scoredAt], map: "gtr_score_repo_time_idx")
  @@map("github_trend_repository_score")
}

model CollectionRun {
  id             String    @id(map: "gtr_run_pk") @db.Char(24)
  status         String    @db.VarChar(24)
  trigger        String    @db.VarChar(24)
  startedAt      DateTime  @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(3)
  candidateCount Int       @default(0) @map("candidate_count")
  enrichedCount  Int       @default(0) @map("enriched_count")
  failedCount    Int       @default(0) @map("failed_count")
  sourceStats    Json?     @map("source_stats")
  errorMessage   String?   @map("error_message") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([startedAt], map: "gtr_run_started_idx")
  @@map("github_trend_collection_run")
}

model RecommendationBatch {
  id             String   @id(map: "gtr_rec_batch_pk") @db.Char(24)
  reportDate     DateTime @unique(map: "gtr_rec_batch_date_uq") @map("report_date") @db.Date
  sourceScoredAt DateTime @map("source_scored_at") @db.Timestamptz(3)
  requestedCount Int      @default(10) @map("requested_count")
  selectedCount  Int      @map("selected_count")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt], map: "gtr_rec_batch_created_idx")
  @@map("github_trend_recommendation_batch")
}

model RecommendationItem {
  id                 String   @id(map: "gtr_rec_item_pk") @db.Char(24)
  batchId            String   @map("batch_id") @db.Char(24)
  repositoryId       String   @unique(map: "gtr_rec_item_repo_uq") @map("repository_id") @db.Char(24)
  position           Int
  scoredAt           DateTime @map("scored_at") @db.Timestamptz(3)
  trendHeat          Float    @map("trend_heat")
  technicalSubstance Float    @map("technical_substance")
  manipulationRisk   Float    @map("manipulation_risk")
  confidence         String   @db.VarChar(16)
  classification     String   @db.VarChar(48)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([batchId, position], map: "gtr_rec_item_batch_pos_uq")
  @@index([batchId], map: "gtr_rec_item_batch_idx")
  @@map("github_trend_recommendation_item")
}
